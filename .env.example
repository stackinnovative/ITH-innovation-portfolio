# Enquiry form email (Resend — https://resend.com)
# Set these in Vercel → Project → Settings → Environment Variables.

# API key from Resend → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. Comma-separate for several inboxes.
ENQUIRY_TO_EMAIL=sales@example.com

# Sender address. Must be on a domain verified in Resend.
# For testing only: onboarding@resend.dev (delivers only to your own Resend account email).
ENQUIRY_FROM_EMAIL=enquiries@example.com

# Public site URL (no trailing slash) — used for canonical links, Open Graph, sitemap and robots.
# Falls back to Vercel's production URL when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Sanity CMS — rental equipment (studio/ is the editor). From sanity.io/manage → your project.
# Leave SANITY_PROJECT_ID unset to use the built-in list in content/site.ts.
SANITY_PROJECT_ID=abc123de
SANITY_DATASET=production
# Any long random string; paste the same value as the webhook "Secret" in Sanity → API → Webhooks.
SANITY_REVALIDATE_SECRET=change-me
